# Root env for docker compose. Copy to .env and fill in the secrets.
# APP_KEY: run `cd api && php artisan key:generate --show`
APP_KEY=
APP_URL=http://localhost:8080
HTTP_PORT=8080
PUBLIC_HOST=localhost

DB_PASSWORD=pricelens
DB_ROOT_PASSWORD=root

REVERB_APP_ID=pricelens
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Shared secret between the API and the renderer (any long random string).
RENDERER_TOKEN=

# Tenant API key used by the demo UI's server-side BFF (from `docker compose run --rm migrate` output
# or `php artisan pricelens:tenant:create "My Tenant" --plan=pro`).
PRICELENS_API_KEY=

# Optional providers / features
SERPAPI_KEY=
BRAVE_SEARCH_KEY=
GOOGLE_VISION_API_KEY=
ANTHROPIC_API_KEY=

# Optional: protect GET /metrics with a bearer token
PRICELENS_METRICS_TOKEN=

# Dashboard users: self-serve signup (spec open item #2; default admin-provisioned)
PRICELENS_SELF_SIGNUP=false
SANCTUM_STATEFUL_DOMAINS=localhost:8080,localhost
MAIL_MAILER=log

# Observability (see docker-compose.observability.yml)
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_LARAVEL_DSN=

# Non-production only: hosts allowed to resolve to private IPs (fixture farm, canary)
PRICELENS_SSRF_ALLOW_HOSTS=
