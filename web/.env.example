# --- Server-only (never exposed to the browser) ---------------------------
# Laravel API base URL including the version prefix, reachable from the web container.
PRICELENS_API_URL=http://api/api/v1
# Tenant API key used by the BFF route handlers (sent as "Authorization: Bearer ...").
PRICELENS_API_KEY=

# --- Public (inlined into the client bundle at build time) ------------------
# Leave REVERB_KEY/HOST empty to disable websockets; the UI then polls every 2 s.
NEXT_PUBLIC_REVERB_HOST=ws.pricelens.example
NEXT_PUBLIC_REVERB_KEY=
NEXT_PUBLIC_REVERB_PORT=443
NEXT_PUBLIC_REVERB_SCHEME=https
