# HTTP port the renderer listens on (internal network only).
PORT=3100
# Shared secret; callers must send "Authorization: Bearer <RENDERER_TOKEN>".
# Required: the service refuses to start without it (unless NODE_ENV=test).
RENDERER_TOKEN=
# Number of Chromium processes launched at startup.
BROWSER_INSTANCES=4
# Concurrent BrowserContexts allowed per Chromium process.
CONTEXTS_PER_INSTANCE=4
# Default navigation timeout when a request omits timeout_ms.
DEFAULT_TIMEOUT_MS=20000
# Optional
# HOST=0.0.0.0
# LOG_LEVEL=info

# --- Address policy (SSRF guard inside the browser) ---
# Block every browser request (navigation, redirect hop, subresource, fetch,
# WebSocket) whose host is local-only or resolves to a private/reserved range.
# The service refuses to start with "false" when NODE_ENV=production
# (NODE_ENV defaults to production).
RENDERER_BLOCK_PRIVATE=true
# Comma list of hosts that bypass the address policy: exact hosts / IP literals
# or "*.suffix" wildcards (subdomains only). For tests and the load-test
# fixture farm, e.g. RENDERER_ALLOW_HOSTS=*.fixture.test,127.0.0.1
RENDERER_ALLOW_HOSTS=

# --- Optional OpenTelemetry (OTLP/HTTP). Tracing is off unless set. ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_SERVICE_NAME=pricelens-renderer
