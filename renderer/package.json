{
  "name": "@pricelens/renderer",
  "version": "0.1.0",
  "private": true,
  "description": "PriceLens internal headless rendering service (Fastify + Playwright Chromium)",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "browsers:install": "playwright install chromium"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/core": "3.0.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "fastify": "5.12.7",
    "playwright": "1.64.1",
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
